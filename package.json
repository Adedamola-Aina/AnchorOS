{
  "name": "anchor-os",
  "private": true,
  "version": "1.20.2-rc.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --config config/vite.config.ts",
    "build:staging": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --mode staging --config config/vite.config.ts",
    "build:production": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --mode production --config config/vite.config.ts",
    "lint": "eslint --config config/eslint.config.js .",
    "preview": "vite preview --config config/vite.config.ts",
    "test": "vitest --config config/vitest.config.ts",
    "test:run": "vitest --run --config config/vitest.config.ts",
    "test:ui": "vitest --ui --config config/vitest.config.ts",
    "test:coverage": "vitest --coverage --run --config config/vitest.config.ts",
    "test:coverage:collect": "vitest --coverage --run --config config/vitest.config.ts --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0",
    "test:coverage:functions": "cd functions && npx vitest --coverage --run --config vitest.config.ts && cd ..",
    "test:coverage:query-gate": "vitest --config config/vitest.config.ts --run src/services/fabric/__tests__/query/*.test.ts src/services/fabric/__tests__/QueryEngine.test.ts src/services/fabric/__tests__/QueryEngine.extended.test.ts src/services/fabric/__tests__/QueryEngine.routes.test.ts --coverage --coverage.include=src/services/fabric/query/**/*.ts --coverage.include=src/services/fabric/QueryEngine.ts --coverage.thresholds.statements=99 --coverage.thresholds.branches=85 --coverage.thresholds.functions=99 --coverage.thresholds.lines=99",
    "coverage:modules": "node scripts/generate-module-coverage.mjs",
    "test:coverage:modules": "npm run test:coverage:collect && npm run coverage:modules",
    "test:e2e": "npx playwright test --config config/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --ui --config config/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --headed --config config/playwright.config.ts",
    "test:visual": "npx playwright test visual.spec.ts --config config/playwright.config.ts",
    "test:visual:update": "npx playwright test visual.spec.ts --update-snapshots --config config/playwright.config.ts",
    "lighthouse": "lhci autorun --config=config/lighthouserc.cjs",
    "lighthouse:collect": "lhci collect",
    "test:integration": "./scripts/test-with-emulator.sh",
    "test:rules": "firebase emulators:exec --only firestore,storage 'npx vitest run --config config/vitest.rules.config.ts'",
    "test:rules:ci": "firebase emulators:exec --only firestore,storage 'npx vitest run --config config/vitest.rules.config.ts && npx tsx tools/ci/check-rules-coverage.ts'",
    "check:rules-coverage": "npx tsx tools/ci/check-rules-coverage.ts",
    "check:indexes": "npx tsx tools/ci/check-index-catalog.ts",
    "check:index-usage": "npx tsx tools/ci/check-index-usage.ts",
    "check:dead-code": "knip",
    "emulator:start": "firebase emulators:start --config config/firebase.json",
    "build:dev": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --mode development --config config/vite.config.ts",
    "deploy:dev": "./scripts/DEPLOY_PIPELINE.sh --env=development",
    "deploy:staging": "./scripts/DEPLOY_PIPELINE.sh --env=staging",
    "deploy:production": "./scripts/DEPLOY_PIPELINE.sh --env=production",
    "build:analyze": "ANALYZE=true vite build --config config/vite.config.ts",
    "analytics:validate": "vitest --config config/vitest.config.ts --run src/analytics/contract.test.ts",
    "test:mutation": "stryker run config/stryker.config.mjs",
    "test:mutation:ci": "stryker run config/stryker.ci.config.mjs",
    "test:mutation:dry": "stryker run --dryRunOnly config/stryker.config.mjs",
    "prepare": "husky",
    "version:dev": "npx commit-and-tag-version --prerelease dev --skip.changelog --skip.commit --skip.tag",
    "version:staging": "npx commit-and-tag-version --prerelease rc --skip.commit --skip.tag",
    "version:production": "npx commit-and-tag-version --skip.commit --skip.tag",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "ios:sync": "bash ./scripts/ios-native-sync.sh",
    "ios:open": "npm run ios:sync && open ./apps/ios-native/AnchorOSNative.xcodeproj",
    "ui:capture": "npx tsx tools/ui-capture/index.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-badge": "^8.0.1",
    "@sentry/react": "^10.48.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@tanstack/react-query-persist-client": "^5.99.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@testing-library/dom": "^10.4.1",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.8.0",
    "postcss": "^8.5.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.1.1",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.2",
    "@vitest/ui": "4.1.2",
    "commit-and-tag-version": "^12.7.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^3.23.2",
    "firebase-admin": "^13.7.0",
    "globals": "^17.4.0",
    "happy-dom": "20.8.9",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^6.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "4.1.2"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "tmp": ">=0.2.4",
    "inquirer": ">=10.0.0",
    "@xmldom/xmldom": ">=0.8.12",
    "lodash-es": ">=4.18.0"
  }
}
