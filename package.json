{
  "name": "anchor-os",
  "private": true,
  "version": "1.7.4",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --config config/vite.config.ts",
    "build:staging": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --mode staging --config config/vite.config.ts",
    "build:production": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --mode production --config config/vite.config.ts",
    "lint": "eslint --config config/eslint.config.js .",
    "preview": "vite preview --config config/vite.config.ts",
    "test": "vitest --config config/vitest.config.ts",
    "test:run": "vitest --run --config config/vitest.config.ts",
    "test:ui": "vitest --ui --config config/vitest.config.ts",
    "test:coverage": "vitest --coverage --run --config config/vitest.config.ts",
    "test:e2e": "npx playwright test --config config/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --ui --config config/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --headed --config config/playwright.config.ts",
    "test:visual": "npx playwright test visual.spec.ts --config config/playwright.config.ts",
    "test:visual:update": "npx playwright test visual.spec.ts --update-snapshots --config config/playwright.config.ts",
    "lighthouse": "lhci autorun --config=config/lighthouserc.cjs",
    "lighthouse:collect": "lhci collect",
    "test:integration": "./scripts/test-with-emulator.sh",
    "test:rules": "firebase emulators:exec --only firestore 'npx vitest run --config config/vitest.rules.config.ts'",
    "emulator:start": "firebase emulators:start --config config/firebase.json",
    "build:dev": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --mode development --config config/vite.config.ts",
    "deploy:dev": "./scripts/DEPLOY_PIPELINE.sh --env=development",
    "deploy:staging": "./scripts/DEPLOY_PIPELINE.sh --env=staging",
    "deploy:production": "./scripts/DEPLOY_PIPELINE.sh --env=production",
    "build:analyze": "ANALYZE=true vite build --config config/vite.config.ts",
    "audit:docs": "node scripts/audit-docs.mjs",
    "test:mutation": "stryker run --configFile config/stryker.config.mjs",
    "test:mutation:dry": "stryker run --dryRunOnly --configFile config/stryker.config.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/react": "^10.38.0",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-query-persist-client": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.18",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.8.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.562.0",
    "postcss": "^8.4.49",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/typescript-checker": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.6.0",
    "globals": "^17.2.0",
    "happy-dom": "^20.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "tmp": ">=0.2.4",
    "inquirer": ">=10.0.0"
  }
}
