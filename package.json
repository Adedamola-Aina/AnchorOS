{
  "name": "anchor-os",
  "private": true,
  "version": "1.21.0-rc.38",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "dev:local": "bash scripts/dev-local.sh",
    "build": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --config config/vite.config.ts",
    "build:staging": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --mode staging --config config/vite.config.ts",
    "build:production": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && vite build --mode production --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "lint": "eslint --config config/eslint.config.js .",
    "typecheck": "tsc -b config/tsconfig.app.json config/tsconfig.node.json && tsc -p config/tsconfig.spec.json --noEmit",
    "test": "vitest --config config/vitest.config.ts",
    "test:run": "vitest --run --config config/vitest.config.ts",
    "test:coverage": "vitest --coverage --run --config config/vitest.config.ts",
    "test:rules": "firebase emulators:exec --project demo-anchor-os --only firestore,storage 'npx vitest run --config config/vitest.rules.config.ts'",
    "test:functions:emulator": "firebase emulators:exec --project demo-anchor-os --only firestore 'cd functions && npx vitest run --config vitest.emulator.config.ts'",
    "emulator:start": "firebase emulators:start --project demo-anchor-os --only auth,firestore,functions,storage",
    "check:dead-code": "knip",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "deploy:staging": "./scripts/deploy.sh --env=staging",
    "deploy:production": "./scripts/deploy.sh --env=production --yes",
    "prepare": "husky",
    "version:dev": "npx commit-and-tag-version --prerelease dev --skip.changelog --skip.commit --skip.tag",
    "version:staging": "npx commit-and-tag-version --prerelease rc --skip.commit --skip.tag",
    "version:production": "npx commit-and-tag-version --skip.commit --skip.tag"
  },
  "dependencies": {
    "@anchor-os/ui": "1.0.0",
    "@sentry/react": "^10.74.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-query-persist-client": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.23",
    "@testing-library/dom": "^10.4.2",
    "autoprefixer": "^10.6.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "framer-motion": "^12.43.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.58.0",
    "postcss": "^8.5.30",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^3.23.2",
    "firebase-admin": "^13.7.0",
    "globals": "^17.13.0",
    "happy-dom": "20.14.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "tmp": ">=0.2.4",
    "inquirer": ">=10.0.0",
    "@xmldom/xmldom": ">=0.9.10",
    "lodash-es": ">=4.18.0",
    "@puppeteer/browsers": "^3.2.2",
    "uuid": "^11.1.1"
  }
}
