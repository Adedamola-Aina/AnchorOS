#!/bin/bash
# ARCH-001 Enforcement: Reject commits with files exceeding 200 lines
# Per CLAUDE.md §3.2: "No single file should exceed 200 lines of code."

MAX_LINES=200
VIOLATIONS=""

# Check all staged .ts and .tsx files (excluding tests)
for file in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v '\.test\.' | grep -v '\.spec\.'); do
    if [ -f "$file" ]; then
        lines=$(wc -l < "$file")
        if [ "$lines" -gt "$MAX_LINES" ]; then
            VIOLATIONS="$VIOLATIONS\n  ❌ $file ($lines lines)"
        fi
    fi
done

if [ -n "$VIOLATIONS" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  ARCH-001 VIOLATION: Files exceed 200-line limit             ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    echo "The following files violate CLAUDE.md §3.2:"
    echo -e "$VIOLATIONS"
    echo ""
    echo "→ Split into smaller files before committing."
    echo "→ Extract components, hooks, or utilities as needed."
    echo ""
    exit 1
fi

exit 0
