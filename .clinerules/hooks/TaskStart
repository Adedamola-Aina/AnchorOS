#!/usr/bin/env node
'use strict';

/**
 * Workhorse v1 — Cline TaskStart hook (project-local).
 *
 * Contract: Cline invokes this executable with a single JSON payload on stdin
 * (see @cline/shared HookEventPayloadBase). We read the workspace from
 * `workspaceRoots`, inject a compact task context via `contextModification`,
 * and cancel coding tasks that would run on master or on a worktree whose
 * recorded Workhorse base metadata is missing or invalid.
 *
 * Output: one line of JSON on stdout ({ contextModification } or
 * { cancel: true, errorMessage }). Diagnostics go to stderr only.
 *
 * This hook never mutates the repository, never fetches, and never runs tests.
 */

import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import process from 'node:process';

function readStdin() {
    try {
        return fs.readFileSync(0, 'utf8');
    } catch {
        return '';
    }
}

function parsePayload(raw) {
    try {
        const parsed = JSON.parse(raw);
        return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : null;
    } catch {
        return null;
    }
}

function git(cwd, args) {
    return execFileSync('git', args, {
        cwd,
        encoding: 'utf8',
        stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
}

function gitOk(cwd, args) {
    try {
        git(cwd, args);
        return true;
    } catch {
        return false;
    }
}

function emit(obj) {
    process.stdout.write(`${JSON.stringify(obj)}\n`);
}

function debug(msg) {
    process.stderr.write(`[TaskStart] ${msg}\n`);
}

function cancel(message) {
    emit({ cancel: true, errorMessage: message });
    process.exit(0);
}

const payload = parsePayload(readStdin());
if (!payload) {
    cancel('Workhorse TaskStart: malformed hook payload (stdin was not a JSON object).');
}
const workspace =
    (Array.isArray(payload.workspaceRoots) && payload.workspaceRoots[0]) ||
    payload.workspaceInfo?.rootPath ||
    process.cwd();

let root;
let branch;
let head;
try {
    root = git(workspace, ['rev-parse', '--show-toplevel']);
    branch = git(workspace, ['rev-parse', '--abbrev-ref', 'HEAD']);
    head = git(workspace, ['rev-parse', 'HEAD']);
} catch (error) {
    debug(`not a git workspace: ${String(error)}`);
    cancel(
        'AnchorOS coding sessions must run in a linked Workhorse worktree created by scripts/agent/start-task.sh (the workspace is not a git repository).'
    );
}

// Safety 1: never start a coding task on master.
if (branch === 'master') {
    cancel(
        'Refusing to start a coding task on the master branch. Create an isolated task worktree with scripts/agent/start-task.sh <branch>.'
    );
}

const baseSha = gitOk(root, ['config', '--get', 'workhorse.baseSha'])
    ? git(root, ['config', '--get', 'workhorse.baseSha'])
    : '';

const originMaster = gitOk(root, ['rev-parse', 'origin/master'])
    ? git(root, ['rev-parse', 'origin/master'])
    : '';

const linkedWorktree = (() => {
    try {
        const gitDir = path.resolve(root, git(root, ['rev-parse', '--git-dir']));
        const commonDir = path.resolve(root, git(root, ['rev-parse', '--git-common-dir']));
        return gitDir !== commonDir;
    } catch {
        return false;
    }
})();

// Safety 2: AnchorOS coding sessions are only accepted in a linked Workhorse
// worktree. The primary working tree is rejected even on a feature branch,
// because it carries unrelated in-progress work and no recorded base.
if (!linkedWorktree) {
    cancel(
        'Refusing to start an AnchorOS coding session in the primary working tree. Create an isolated Workhorse worktree with scripts/agent/start-task.sh <branch>.'
    );
}

// Safety 3: a linked Workhorse worktree must carry its recorded base SHA.
if (!baseSha) {
    cancel(
        'Workhorse base metadata is missing for this linked worktree. Create the task with scripts/agent/start-task.sh so the base SHA is recorded.'
    );
}

// Safety 3: the recorded base must be a valid, reachable ancestor of HEAD.
if (baseSha) {
    if (!gitOk(root, ['rev-parse', '--verify', '--quiet', `${baseSha}^{commit}`])) {
        cancel(`Recorded Workhorse base SHA ${baseSha} is not a commit in this repository.`);
    }
    if (!gitOk(root, ['merge-base', '--is-ancestor', baseSha, 'HEAD'])) {
        cancel(
            `Recorded Workhorse base SHA ${baseSha} is not an ancestor of HEAD; the branch was rebased or rewritten. Recreate the task worktree.`
        );
    }
}

const status = gitOk(root, ['status', '--short']) ? git(root, ['status', '--short']) : '';
const workflows = gitOk(root, ['ls-files', '.github/workflows'])
    ? git(root, ['ls-files', '.github/workflows'])
    : '';

const statusLines = status ? status.split('\n').slice(0, 40) : [];
const statusBlock = statusLines.length ? statusLines.join('\n') : '(clean)';
const workflowBlock = workflows ? workflows.split('\n').join(', ') : '(none)';

const context = [
    'Workhorse task context (injected by .clinerules/hooks/TaskStart):',
    `repository_root: ${root}`,
    `branch: ${branch}`,
    `head_sha: ${head}`,
    `workhorse_base_sha: ${baseSha || '(none recorded)'}`,
    `origin_master_sha: ${originMaster || '(origin/master not available locally)'}`,
    `workspace_kind: ${linkedWorktree ? 'isolated harness worktree' : 'primary working tree'}`,
    'git_status:',
    statusBlock,
    `tracked_workflows: ${workflowBlock}`,
].join('\n');

emit({ contextModification: context });
