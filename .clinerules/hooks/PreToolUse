#!/usr/bin/env node
'use strict';

/**
 * Workhorse v1 — Cline PreToolUse safety hook (project-local).
 *
 * Contract: Cline invokes this executable with one JSON payload on stdin
 * (hookName: "PreToolUse", preToolUse.toolName, preToolUse.parameters,
 * workspaceRoots). We fail closed for dangerous operations and structural
 * payload errors, while allowing ordinary development work.
 *
 * Output: one line of JSON on stdout. Blocked -> { cancel: true, errorMessage }.
 * Allowed -> {}. Diagnostics go to stderr only.
 *
 * Explicit, small checks — not a shell parser and not a policy engine.
 */

import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import process from 'node:process';

function readStdin() {
    try {
        return fs.readFileSync(0, 'utf8');
    } catch {
        return '';
    }
}

function emit(obj) {
    process.stdout.write(`${JSON.stringify(obj)}\n`);
}

function block(reason) {
    process.stderr.write(`[PreToolUse] BLOCK: ${reason}\n`);
    emit({ cancel: true, errorMessage: reason });
    process.exit(0);
}

function allow() {
    emit({});
    process.exit(0);
}

// ---------------------------------------------------------------------------
// Structural validation — fail closed on malformed or missing input.
// ---------------------------------------------------------------------------

let payload;
try {
    payload = JSON.parse(readStdin());
} catch {
    block('Blocked: malformed hook payload (stdin was not valid JSON).');
}

if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
    block('Blocked: malformed hook payload (expected a JSON object).');
}

const preToolUse = payload.preToolUse;
if (
    !preToolUse ||
    typeof preToolUse !== 'object' ||
    Array.isArray(preToolUse) ||
    typeof preToolUse.toolName !== 'string' ||
    preToolUse.toolName.length === 0
) {
    block('Blocked: missing or invalid preToolUse payload (a string toolName is required).');
}

const toolName = preToolUse.toolName;
const parameters =
    preToolUse.parameters && typeof preToolUse.parameters === 'object' && !Array.isArray(preToolUse.parameters)
        ? preToolUse.parameters
        : {};
const workspace =
    (Array.isArray(payload.workspaceRoots) && typeof payload.workspaceRoots[0] === 'string' && payload.workspaceRoots[0]) ||
    payload.workspaceInfo?.rootPath ||
    process.cwd();

// ---------------------------------------------------------------------------
// Forbidden paths: .env, .env.*, e2e/.auth/**  (narrow: path targets only)
// ---------------------------------------------------------------------------

const ENV_BASENAME = /^\.env($|\.)/;
const PATH_KEYS = ['path', 'file_path', 'filepath', 'target_file', 'relative_path', 'filename'];

function isForbiddenPath(value) {
    if (typeof value !== 'string' || value.trim() === '') {
        return false;
    }
    const normalized = value.replace(/\\/g, '/').trim();
    if (normalized.includes('e2e/.auth')) {
        return true;
    }
    return ENV_BASENAME.test(normalized.split('/').pop());
}

function forbiddenPathParameter() {
    for (const key of PATH_KEYS) {
        if (isForbiddenPath(parameters[key])) {
            return key;
        }
    }
    // apply_patch targets appear as file headers, not as a path parameter.
    const patchText =
        typeof parameters.input === 'string'
            ? parameters.input
            : typeof parameters.patch === 'string'
              ? parameters.patch
              : '';
    if (patchText) {
        for (const line of patchText.split('\n')) {
            const match = line.match(/^\*\*\*\s+(?:Update|Add|Delete)\s+File:\s*(.+?)\s*$/);
            if (match && isForbiddenPath(match[1])) {
                return 'input';
            }
        }
    }
    return null;
}

const forbiddenKey = forbiddenPathParameter();
if (forbiddenKey) {
    block(`Blocked: accessing a forbidden path (.env / .env.* / e2e/.auth/**) via parameter "${forbiddenKey}".`);
}

function commandMentionsForbiddenPath(command) {
    return command
        .split(/\s+/)
        .map((token) => token.replace(/^[>&<|`"']+/, '').replace(/["'`,;:]+$/, ''))
        .some(isForbiddenPath);
}

// ---------------------------------------------------------------------------
// Shell command checks (the execute_command tool)
// ---------------------------------------------------------------------------

const MUTATING_GIT = new Set([
    'push',
    'add',
    'reset',
    'clean',
    'commit',
    'merge',
    'rebase',
    'checkout',
    'switch',
    'restore',
    'stash',
    'cherry-pick',
]);

function currentBranch() {
    try {
        return execFileSync('git', ['rev-parse', '--abbrev-ref', 'HEAD'], {
            cwd: workspace,
            encoding: 'utf8',
            stdio: ['ignore', 'pipe', 'ignore'],
        }).trim();
    } catch {
        return null;
    }
}

function findGitTokenIndex(tokens) {
    return tokens.findIndex(
        (token) => token === 'git' || (token.includes('/') && token.split('/').pop() === 'git')
    );
}

function analyzeGitSegment(segment, context) {
    const tokens = segment.trim().split(/\s+/);
    const gitIndex = findGitTokenIndex(tokens);
    if (gitIndex === -1) {
        return;
    }
    const after = tokens.slice(gitIndex + 1);

    let subIndex = -1;
    let sub = '';
    for (let i = 0; i < after.length; i += 1) {
        if (MUTATING_GIT.has(after[i])) {
            subIndex = i;
            sub = after[i];
            break;
        }
    }
    if (subIndex === -1) {
        return; // read-only or unrecognised git command
    }

    const before = after.slice(0, subIndex);
    const args = after.slice(subIndex + 1);

    // Fail closed when the target checkout cannot be trusted.
    if (context.branch === null) {
        block('Blocked: cannot determine the current branch for a mutating git command.');
    }
    const crossRepo =
        before.some(
            (token) =>
                token === '-C' ||
                token === '--git-dir' ||
                token === '--work-tree' ||
                token.startsWith('--git-dir=') ||
                token.startsWith('--work-tree=')
        ) || context.hasCd;
    if (crossRepo) {
        block('Blocked: mutating git targeting another checkout (git -C / --git-dir / preceding cd).');
    }
    if (context.branch === 'master') {
        block(`Blocked: mutating git ${sub} while the workspace branch is master.`);
    }

    if (sub === 'push') {
        const forced = args.some((arg) => arg === '-f' || arg.startsWith('--force') || /^\+/.test(arg));
        if (forced) {
            block('Blocked: git push --force / -f (force push).');
        }
        const toMaster = args.some(
            (arg) =>
                arg === 'master' ||
                arg === 'refs/heads/master' ||
                arg.endsWith(':master') ||
                arg.endsWith(':refs/heads/master')
        );
        if (toMaster) {
            block('Blocked: push directly to master.');
        }
        return;
    }

    if (sub === 'add') {
        const stagesEverything = args.some((arg) =>
            ['.', './', '..', '-A', '--all', '-a', '-u', '--update', '*'].includes(arg)
        );
        if (stagesEverything) {
            block('Blocked: broad staging (git add . / ./- / -A / --all / -u / --update). Stage explicit paths only.');
        }
        return;
    }

    if ((sub === 'checkout' || sub === 'switch') && args.some((arg) => arg === 'master' || arg === 'refs/heads/master')) {
        block('Blocked: checking out or switching to master from a Workhorse session.');
    }

    if (sub === 'reset' && args.includes('--hard')) {
        block('Blocked: git reset --hard.');
    }

    if (sub === 'clean') {
        const destructive = args.some(
            (arg) => arg.startsWith('--force') || (/^-[a-z]+$/.test(arg) && arg.includes('f'))
        );
        if (destructive) {
            block('Blocked: destructive git clean.');
        }
    }
}

function analyzeCommand(command) {
    const branch = currentBranch();
    const context = {
        branch,
        hasCd: /(?:^|[;&|()]|\n)\s*cd\s/.test(command),
    };
    const segments = command.split(/&&|\|\||;|\n/);

    for (const segment of segments) {
        const raw = segment.trim();
        if (!raw) {
            continue;
        }
        const lower = raw.toLowerCase();

        if (/\bgh\b\s+pr\s+merge\b/.test(lower)) {
            block('Blocked: gh pr merge (PR merge is not allowed from the harness).');
        }
        if (/\bfirebase\b[^\n]*\bdeploy\b/.test(lower)) {
            block('Blocked: raw firebase deploy. Use the repository deploy pipeline with approval.');
        }
        if (/\bdeploy:(staging|production|prod)\b/.test(lower)) {
            block('Blocked: staging/production deployment command.');
        }
        if (/deploy_pipeline\.sh/.test(lower)) {
            block('Blocked: direct invocation of scripts/DEPLOY_PIPELINE.sh.');
        }
        if (/\brunmigration\b/.test(lower)) {
            block('Blocked: runMigration execution.');
        }
        if (/\bmigrations?:(apply|run)\b/.test(lower)) {
            block('Blocked: migration application.');
        }
        if (/firestore:delete|functions:delete/.test(lower)) {
            block('Blocked: destructive production operation.');
        }
        if (/\bgcloud\b[^\n]*\bdelete\b/.test(lower)) {
            block('Blocked: destructive gcloud delete operation.');
        }

        analyzeGitSegment(raw, context);
    }
}

if (toolName === 'execute_command') {
    const command = typeof parameters.command === 'string' ? parameters.command : '';
    if (command) {
        if (commandMentionsForbiddenPath(command)) {
            block('Blocked: accessing a forbidden path (.env / .env.* / e2e/.auth/**) in a shell command.');
        }
        analyzeCommand(command);
    }
}

allow();
