{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "config/vitest.rules.config.ts",
    "src/__tests__/*.emulator.ts",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/test/**",
    "functions/**",
    "packages/**",
    "scripts/**"
  ],
  "ignoreBinaries": [
    "firebase"
  ],
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "postcss",
    "tailwindcss",
    "tailwindcss-animate",
    "autoprefixer",
    "@commitlint/config-conventional",
    "firebase-admin"
  ]
}
