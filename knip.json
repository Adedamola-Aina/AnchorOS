{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "src/test/**",
    "e2e/**",
    "functions/**",
    "android/**",
    "ios/**",
    "packages/**",
    "tools/**",
    "scripts/**",
    "config/**"
  ],
  "ignoreDependencies": [
    "@capacitor/*",
    "@tailwindcss/postcss",
    "postcss",
    "tailwindcss",
    "tailwindcss-animate",
    "autoprefixer",
    "recharts",
    "@commitlint/config-conventional"
  ]
}
