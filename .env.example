# ============================================================================
# ANCHOR OS - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
#
# Copy this file to create environment-specific files:
#   cp .env.example .env.development
#
# IMPORTANT: Never commit actual .env files to git!
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT IDENTIFIER
# ----------------------------------------------------------------------------
VITE_APP_ENV=development

# ----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (LOCAL EMULATOR SUITE)
# ----------------------------------------------------------------------------
# Development runs 100% against the LOCAL Firebase Emulator Suite under the
# demo project identity below. The app FAILS FAST if development is pointed
# at a real Firebase project ID — never put staging/production values here.
#
# Staging/production Firebase values are injected by GitHub environment
# secrets during deploys. They are NOT needed for development and must
# NEVER be copied into this file.
#
# No real API key, App Check key, or VAPID key is required locally: these are
# harmless dummy values that satisfy SDK initialization only.
VITE_FIREBASE_PROJECT_ID=demo-anchor-os
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-anchor-os.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-anchor-os.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo-anchor-os
VITE_FIREBASE_MEASUREMENT_ID=

# App Check / FCM are DISABLED in emulator development — leave these empty.
# (Emulator development resolves Messaging to null and skips App Check.)
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_VAPID_KEY=

# ----------------------------------------------------------------------------
# EXTERNAL SERVICES
# ----------------------------------------------------------------------------
# Formspree contact form endpoint ID (optional)
VITE_FORMSPREE_ID=your_formspree_endpoint_id

# Sentry error tracking DSN (optional) — leave EMPTY in development.
# A placeholder here produces "Invalid Sentry Dsn" console errors and a
# real DSN must never be committed or copied into dev environments.
VITE_SENTRY_DSN=

# ----------------------------------------------------------------------------
# FIELD-LEVEL ENCRYPTION (SEC-005)
# ----------------------------------------------------------------------------
# AES-GCM 256-bit encryption for sensitive financial fields (balanceCents, amountCents).
# Leave empty to disable encryption (default for dev).
# Generate with: openssl rand -base64 32
# IMPORTANT: Changing this key makes all previously encrypted data unreadable.
VITE_FIELD_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# MONO OPEN BANKING (Nigerian bank integration)
# ----------------------------------------------------------------------------
# Get your public key from https://app.mono.co/apps → Settings → API Keys
VITE_MONO_PUBLIC_KEY=test_pk_xxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# ----------------------------------------------------------------------------
# Global kill-switch for all rollout flags
# VITE_FLAG_DISABLE_ALL=false

# Anchor AI progressive rollout controls (anchor_ai_enabled)
# VITE_FLAG_ANCHOR_AI_ENABLED=true
# VITE_FLAG_ANCHOR_AI_ROLLOUT=100
