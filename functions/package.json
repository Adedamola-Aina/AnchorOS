{
  "name": "anchor-os-functions",
  "description": "Cloud Functions for Anchor OS",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "echo \"Use root deploy pipeline: npm run deploy:dev|deploy:staging|deploy:production\" && exit 1"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.0",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "resend": "^6.8.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1"
  },
  "private": true
}
