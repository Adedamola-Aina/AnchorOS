# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files (contain secrets — never commit)
.env
.env.development
.env.staging
.env.production
.env.local
.env.*.local

# Generated at build time from env vars
public/__firebase-config.js

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
test-results/
coverage/
playwright-report/
# Playwright storageState (Firebase Auth session/refresh tokens) — never commit
e2e/.auth/
functions/lib/
src/.claude/
.firebase/
firestore-debug.log

# UI Capture output
.ui-captures/

# Stryker incremental cache
.stryker-tmp/

# Capacitor
ios/
android/
.capacitor/
Capacitor.asar

# Claude Code workflow locks (session state — not project state)
.claude/gather.lock
.claude/plan.lock
.codex

# Stryker mutation testing artifacts
stryker-setup-*.js
stryker-setup-*.js.map
reports/
.lighthouseci/

# Retired internal PM dashboard / MCP tooling — extracted from the repository.
# Must never be re-tracked as an engineering source of truth.
tools/dashboard/
tools/mcp-server/

# Cline agent state (RA-19). Holds provider API keys
# (.cline/data/settings/providers.json), session transcripts that can contain
# pasted secrets, and local caches. Nothing under it is tracked, so ignoring the
# whole directory is safe — and it must never be committed.
.cline/

# Design reference screenshots (third-party Mobbin / App Store captures).
# Kept local on the server for design analysis only — never redistributed in the
# repository, never pasted into PRs or releases. See
# docs/audits/2026-09-whole-product/references/README.md
docs/audits/2026-09-whole-product/references/**/*.png
docs/audits/2026-09-whole-product/references/**/*.jpg
docs/audits/2026-09-whole-product/references/**/*.jpeg
docs/audits/2026-09-whole-product/references/**/*.webp
docs/audits/2026-09-whole-product/references/**/*.gif
