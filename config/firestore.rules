rules_version = '2';
// ARCH-026: rule path coverage enforced via tools/ci/check-rules-coverage.ts
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Type Validation Helpers
    function isValidAccount(data) {
      return data.name is string && data.name.size() > 0
          && data.balanceCents is int
          && data.type in ['checking', 'savings', 'credit', 'investment', 'cash', 'salary']
          && (data.currency == 'NGN' || data.currency == 'USD');
    }

    function isValidTransaction(data) {
      return data.title is string && data.title.size() > 0
          && data.amountCents is int && data.amountCents >= 0
          && data.type in ['income', 'expense', 'transfer']
          && data.date is string;
    }

    function isValidRecurringTransaction(data) {
      return data.userId is string && data.userId.size() > 0
          && data.accountId is string && data.accountId.size() > 0
          && data.title is string && data.title.size() > 0
          && data.amountCents is int && data.amountCents > 0
          && data.type in ['income', 'expense']
          && data.frequency in ['weekly', 'monthly', 'yearly']
          && data.interval is int && data.interval > 0
          && data.status in ['active', 'paused']
          && data.nextRunAt is string;
    }

    function isValidTask(data) {
       return data.title is string && data.title.size() > 0
          && data.completed is bool;
    }

    function isValidMoodEntry(data, expectedDate) {
      return data.keys().hasOnly(['date', 'mood', 'note', 'createdAt'])
          && data.keys().hasAll(['date', 'mood', 'createdAt'])
          && data.date is string && data.date == expectedDate
          && data.mood is int && data.mood >= 1 && data.mood <= 5
          && (!data.keys().hasAny(['note']) || (data.note is string && data.note.size() <= 280))
          && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50;
    }

    // Family Mode v2: Check if user is connected family member
    // Checks for existence of deterministic connection document (uid1_uid2 or uid2_uid1)
    function isConnectedFamilyMember(userId) {
      return exists(/databases/$(database)/documents/artifacts/anchor-os/family_connections/$(userId + '_' + request.auth.uid)) ||
             exists(/databases/$(database)/documents/artifacts/anchor-os/family_connections/$(request.auth.uid + '_' + userId));
    }

    match /artifacts/anchor-os {

      // ======================================================================
      // Recurring Transactions Collection
      // ======================================================================
      match /recurring_transactions/{ruleId} {
        allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && isValidRecurringTransaction(request.resource.data);
        allow read: if request.auth != null && (
          resource.data.userId == request.auth.uid ||
          request.auth.uid in resource.data.get('sharedWith', [])
        );
        allow update: if request.auth != null
                      && resource.data.userId == request.auth.uid
                      && isValidRecurringTransaction(request.resource.data);
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
      
      // ======================================================================
      // Family Mode v2: Invitations
      // Cloud Functions (Admin SDK) handle most writes; client rules for reads + DevTools
      // ======================================================================
      match /family_invitations/{inviteId} {
        // Read: only the invitation owner or the invitee
        allow read: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || resource.data.inviteeEmail == request.auth.token.email
                        || resource.data.get('inviteeUid', '') == request.auth.uid);
        // Writes are Cloud Functions/Admin SDK only to prevent client-side tampering.
        allow create, update, delete: if false;
      }

      // ======================================================================
      // Family Mode v2: Connections
      // Cloud Functions (Admin SDK) handle creation; client rules for reads + DevTools
      // ======================================================================
      match /family_connections/{connectionId} {
        // Read: only the two connected parties
        allow read: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || resource.data.memberUid == request.auth.uid);
        // Writes are Cloud Functions/Admin SDK only to prevent client-side tampering.
        allow create, update, delete: if false;
      }

      // ======================================================================
      // Audit Log (no client access)
      // ======================================================================
      match /audit_log/{logId} {
        allow read, write: if false;
      }

      // ======================================================================
      // Users Collection
      // ======================================================================
      match /users/{userId} {
        function getAccountById(accountId) {
          return get(/databases/$(database)/documents/artifacts/anchor-os/users/$(userId)/accounts/$(accountId));
        }

        function accountExists(accountId) {
          return exists(/databases/$(database)/documents/artifacts/anchor-os/users/$(userId)/accounts/$(accountId));
        }

        function accountOwnerUid(accountId) {
          return getAccountById(accountId).data.get('ownerId', userId);
        }

        function sharedPermission(accountId) {
          return getAccountById(accountId).data.get('sharedWith', {})[request.auth.uid].permission;
        }

        function hasLegacyPermission(accountId, perm) {
          return getAccountById(accountId).data.get('shares', {})[request.auth.uid] == perm;
        }

        function hasManagePermission(accountId) {
          return accountExists(accountId)
                 && (accountOwnerUid(accountId) == request.auth.uid
                     || hasLegacyPermission(accountId, 'manage')
                     || sharedPermission(accountId) == 'manage');
        }

        function hasTransactPermission(accountId) {
          return accountExists(accountId)
                 && (accountOwnerUid(accountId) == request.auth.uid
                     || hasLegacyPermission(accountId, 'manage')
                     || hasLegacyPermission(accountId, 'transact')
                     || sharedPermission(accountId) == 'manage'
                     || sharedPermission(accountId) == 'transact');
        }

        allow read: if request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if request.auth.uid == userId;

        match /settings/{docId} {
          allow read: if request.auth.uid == userId;
          allow write: if request.auth.uid == userId;
        }
        
        // Family config subcollection (for developer tools simulation)
        match /family/{docId} {
          allow read: if request.auth.uid == userId;
          allow write: if request.auth.uid == userId;
        }

        // FCM Tokens for Push Notifications
        match /fcmTokens/{token} {
          allow read, write: if request.auth.uid == userId;
        }

        match /security/{docId} {
          allow read, write: if request.auth.uid == userId;
        }

        // Passkey credentials — owner read only; writes via Cloud Function only
        match /passkeys/{credentialId} {
          allow read: if request.auth.uid == userId;
          allow write: if false; // written exclusively by verifyPasskeyAssertion Cloud Function
        }

        // Daily mood check-ins for Fabric
        match /mood_entries/{entryDate} {
          allow read: if request.auth.uid == userId;
          allow create, update: if request.auth.uid == userId
                                && isValidMoodEntry(request.resource.data, entryDate);
          allow delete: if request.auth.uid == userId;
        }

        // Anchor AI (Fabric 2.0) user-scoped documents
        match /fabric_settings/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /fabric_behavior/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /fabric_predictions/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /fabric_conversations/{date} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /fabric_reports/{reportId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        match /fabric_analytics/{docId} {
          allow read: if request.auth.uid == userId;
          allow write: if false;  // Cloud Functions (Admin SDK) only
        }

        match /fabric_nudge_log/{dateKey} {
          allow read: if request.auth.uid == userId;
          allow write: if false;  // Cloud Functions (Admin SDK) only
        }

        // Bank connections — readable by owner, writeable only by Cloud Functions (Admin SDK)
        match /bankConnections/{connectionId} {
          allow read: if request.auth.uid == userId;
          allow write: if false;
        }

        // Auth event history (SEC-009) — readable by owner, written only by Admin SDK
        match /authEvents/{eventId} {
          allow read: if request.auth.uid == userId;
          allow write: if false;
        }

        // Financial mutation audit ledger (ARCH-022) — append-only, no update/delete
        match /ledger/{entryId} {
          allow read: if request.auth.uid == userId;
          allow create: if request.auth.uid == userId;
          allow update, delete: if false;
        }

        // ====================================================================
        // Accounts: Owner or shared member can read
        // ====================================================================
        match /accounts/{accountId} {
          // Read: owner, legacy shares, sharedWith map, or legacy family scope
          allow read: if request.auth.uid == userId 
                        || (resource.data.get('shares', {})[request.auth.uid] != null)
                        || (resource.data.get('sharedWith', {})[request.auth.uid] != null)
                        || (resource.data.scope == 'family' && isConnectedFamilyMember(userId));
          
          allow create: if request.auth.uid == userId && isValidAccount(request.resource.data);
          
          // Update: owner, manage permission, or connected family member (for balance updates)
          // sharedWith and shares can only be changed by owner
          // Linked account balance/connection can only be changed by Cloud Functions (Admin SDK)
          allow update: if isValidAccount(request.resource.data)
                        && (
                            request.auth.uid == userId
                            || (
                              hasManagePermission(accountId)
                              && request.resource.data.get('sharedWith', {}) == resource.data.get('sharedWith', {})
                              && request.resource.data.get('shares', {}) == resource.data.get('shares', {})
                            )
                            || (
                              hasTransactPermission(accountId)
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceCents', 'updatedAt'])
                              && request.resource.data.get('sharedWith', {}) == resource.data.get('sharedWith', {})
                              && request.resource.data.get('shares', {}) == resource.data.get('shares', {})
                            )
                           )
                        && (resource.data.get('source', 'manual') != 'linked'
                            || !request.resource.data.diff(resource.data).affectedKeys()
                                .hasAny(['balanceCents', 'externalConnection', 'source']));
          
          allow delete: if request.auth.uid == userId;

          // Activity feed for shared accounts
          match /activity/{activityId} {
            // Read: owner or shared account members
            allow read: if request.auth.uid == userId 
                        || get(/databases/$(database)/documents/artifacts/anchor-os/users/$(userId)/accounts/$(accountId)).data.get('sharedWith', {})[request.auth.uid] != null;
            
            // Create: users with access to the account can log activity
            allow create: if request.auth.uid == userId
                          || get(/databases/$(database)/documents/artifacts/anchor-os/users/$(userId)/accounts/$(accountId)).data.get('sharedWith', {})[request.auth.uid] != null;
            
            // No update or delete - activity log is append-only
            allow update, delete: if false;
          }
        }

        // ====================================================================
        // Transactions: Owner or shared account member can read/create
        // ====================================================================
        match /finance/{txId} {
          function isSharedAccountMember() {
            let accountId = resource.data.accountId;
            let account = get(/databases/$(database)/documents/artifacts/anchor-os/users/$(userId)/accounts/$(accountId));
            return request.auth.uid in account.data.get('sharedWith', {}).keys();
          }

          // Read: owner, legacy shares, sharedWith, or family scope
          allow read: if request.auth.uid == userId 
                        || resource.data.get('accountShares', {})[request.auth.uid] != null
                        || isSharedAccountMember()
                        || (resource.data.scope == 'family' && isConnectedFamilyMember(userId));
          
          // Create: owner, or connected family member (simplified for dev/staging)
          allow create: if request.auth != null
                        && isValidTransaction(request.resource.data)
                        && hasTransactPermission(request.resource.data.accountId);
                        
          // Update: owner or manage permission, sharedWith members cannot update
          allow update: if hasManagePermission(resource.data.accountId)
                        && isValidTransaction(request.resource.data);
                        
          // Delete: owner only or sharedWith members with permission
          allow delete: if hasManagePermission(resource.data.accountId);
        }

        // ====================================================================
        // Notifications: User can read/dismiss/create their own
        // ====================================================================
        match /notifications/{notificationId} {
          allow read: if request.auth.uid == userId;
          // User can update read/dismissed flags
          allow update: if request.auth.uid == userId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'dismissed']);
          // Owner can create (for developer tools), Cloud Functions use Admin SDK
          allow create: if request.auth.uid == userId;
          allow delete: if request.auth.uid == userId;
        }
        
        match /commitments/{taskId} {
          allow read: if request.auth.uid == userId || (resource.data.category == 'family' && isConnectedFamilyMember(userId));
          allow create, update: if request.auth.uid == userId && isValidTask(request.resource.data);
          allow delete: if request.auth.uid == userId;
        }

        match /dashboard/{document=**} {
           allow read: if request.auth.uid == userId || isConnectedFamilyMember(userId);
           allow write: if request.auth.uid == userId;
        }
      }

      match /feedback/{feedbackId} {
        allow create: if false;
        allow read: if false;
      }
    }

    // ========================================================================
    // Collection Group Query: Shared Accounts
    // Allows family members to find accounts shared with them across all users
    // ========================================================================
    match /{path=**}/accounts/{accountId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.get('sharedWith', {}).keys();
    }

    // ========================================================================
    // Collection Group Query: Transactions on Shared Accounts  
    // Allows shared members to read transactions using collection group queries
    // ========================================================================
    match /{path=**}/finance/{txId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.get('accountShares', {}).keys();
    }

    // ========================================================================
    // Collection Group Query: Activity on Shared Accounts
    // Owner can query all their activity via collection group;
    // shared members access via the nested accounts/activity rule above
    // ========================================================================
    match /{path=**}/activity/{activityId} {
      allow read: if request.auth != null
                  && resource.data.accountOwnerId == request.auth.uid;
    }

    // Rate limits (Cloud Functions only)
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Passkey challenges — server-issued, short TTL. No direct client access.
    match /passkey_challenges/{challengeId} {
      allow read, write: if false; // managed exclusively by issuePasskeyChallenge + verifyPasskeyAssertion
    }

    // Mail (Firebase Trigger Email extension)
    match /mail/{docId} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
