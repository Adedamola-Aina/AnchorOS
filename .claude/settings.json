{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Search",
      "ListDir",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npx tsc*)",
      "Bash(git *)"
    ],
    "deny": [
      "Bash(firebase deploy*)",
      "Bash(rm -rf /)*",
      "Read(.env*)"
    ]
  }
}
